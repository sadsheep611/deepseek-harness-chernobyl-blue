{
  "name": "dsh-chernobyl-blue-local",
  "version": "1.0.4",
  "description": "DeepSeek Harness 桌面主题，采用 Chernobyl Blue 蓝色配色，浅色与深色模式均带有稳定居中于聊天输入框下方的蓝色光晕。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sadsheep611/deepseek-harness-chernobyl-blue.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "chernobyl-blue"
  ],
  "license": "MIT"
}
