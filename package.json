{
  "name": "dsh-chernobyl-blue-local",
  "version": "1.0.5",
  "description": "DeepSeek Harness 桌面主题，采用 Chernobyl Blue 蓝色配色，支持浅色与深色模式、输入框下方蓝色光晕，以及半透明毛玻璃弹出菜单。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sadsheep611/deepseek-harness-chernobyl-blue.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "chernobyl-blue"
  ],
  "license": "MIT"
}
